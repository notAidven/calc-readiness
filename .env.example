# ─────────────────────────────────────────────────────────────────────────────
# Web (Vite, browser-safe) — compiled into the SPA bundle.
# ─────────────────────────────────────────────────────────────────────────────
# Production/account-enabled dev builds require every value in this block. Exact
# `/demo` ignores them and initializes no auth/API client. A Vite dev build with
# VITE_ACCOUNT_APP_ENABLED unset keeps the compile-time-gated local workflow.
VITE_ACCOUNT_APP_ENABLED=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_OAUTH_DOMAIN=
VITE_AWS_REGION=us-east-1

# Deployed diagnostic API URL (API Gateway, or CloudFront `/api/*`). In account
# mode, missing auth/API configuration is a visible startup failure, never a local city.
VITE_DIAGNOSTIC_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Diagnostic API Lambda (server-only; never expose through VITE_ variables).
# The RDS Data API resolves DB_SECRET_ARN service-side, so no DB password is ever
# read into the function — the Lambda only needs rds-data + GetSecretValue IAM.
# ─────────────────────────────────────────────────────────────────────────────
DB_CLUSTER_ARN=            # Aurora Serverless v2 cluster ARN (resourceArn)
DB_SECRET_ARN=            # least-privilege app_service credentials secret ARN
DB_NAME=calc_readiness
COGNITO_USER_POOL_ID=     # e.g. us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=        # the public SPA app-client id

# ─────────────────────────────────────────────────────────────────────────────
# Migration runner `node db/apply.mjs` (server-only). The admin secret runs the
# DDL; the app_service role password is synced from its own secret.
# ─────────────────────────────────────────────────────────────────────────────
DB_ADMIN_SECRET_ARN=      # master credentials secret (runs the DDL)
DB_APP_SERVICE_SECRET_ARN= # app_service credentials secret (password synced onto the role)

# ─────────────────────────────────────────────────────────────────────────────
# Authoritative scorer (server-only).
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
ITEM_BANK_BUCKET=
SCORING_ENGINE_VERSION=1
EQUIVALENCE_CHECKER_VERSION=1

# ─────────────────────────────────────────────────────────────────────────────
# Live diagnostic integration/smoke tests (server-only; unset -> the tests skip).
# Point at a real Aurora cluster with the Data API enabled + migrations applied
# (`node db/apply.mjs`). The secret must carry the app_service grants; student_id
# is any uuid (the Cognito `sub`), and the server integration test stubs auth.
# ─────────────────────────────────────────────────────────────────────────────
DB_TEST_CLUSTER_ARN=
DB_TEST_SECRET_ARN=
DB_TEST_NAME=
