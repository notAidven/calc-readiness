digraph component {
  rankdir=TB;
  newrank=true;
  nodesep=0.3; ranksep=0.7;
  fontname="Helvetica"; labelloc=t; fontsize=16;
  label="Component Diagram: engines over shared state + offline authoring";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10 fillcolor="#eef2ff" color="#334155"];
  edge [fontname="Helvetica" fontsize=9 color="#475569"];

  // ---- Layer 1: Client ----
  subgraph cluster_client {
    label="Client (Web App)"; style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8"; fontsize=12;
    DUI [label="Diagnostic UI\n(item player + branching)"];
    LUI [label="Lesson UI\n(tutor, check, practice, hints)"];
    GUI [label="Game UI\n(city, buildings, storms)"];
    subgraph cluster_shared {
      label="Shared Client Components"; style="rounded,filled"; fillcolor="#eef7ff"; color="#94a3b8"; fontsize=11;
      GWIDGET [label="Graphing widget"];
      MINPUT [label="Math input +\nanswer-space check"];
      SCLIENT [label="State client"];
    }
  }

  // ---- Layer 2: Core Services ----
  subgraph cluster_services {
    label="Core Services"; style="rounded,filled"; fillcolor="#f0fdf4"; color="#94a3b8"; fontsize=12;
    DENG [label="Diagnostic Engine (Gabe)\nwrites placement_estimate only" fillcolor="#dcfce7"];
    LENG [label="Lesson Engine (Anthony)\nsubmits evidence" fillcolor="#dcfce7"];
    GENG [label="Game Engine (Evan)\nreads mastery; storm sets checkpoint only" fillcolor="#dcfce7"];
    MSVC [label="Mastery Service (shared)\nONLY writer of mastery" fillcolor="#bbf7d0"];
    SCORER [label="Authoritative Scorer\n(AWS Lambda)\nserver recompute for the metric" fillcolor="#fde68a"];
  }

  // ---- Layer 3: Data Stores ----
  subgraph cluster_data {
    label="Data Stores"; style="rounded,filled"; fillcolor="#fef9f3"; color="#94a3b8"; fontsize=12;
    STATE [label="Student State\nplacement_estimate, mastery,\nlesson_stage, completion_status" shape=cylinder fillcolor="#fde8d0"];
    ASSESS [label="Assessment records\nimmutable admin + item_response" shape=cylinder fillcolor="#fde8d0"];
    GRAPHDB [label="Skill Graph registry\n56 CORE nodes + edges" shape=cylinder fillcolor="#fde8d0"];
    BANK [label="Item Bank\nnode, difficulty 1-3, form" shape=cylinder fillcolor="#fde8d0"];
    AUTH [label="Auth / Accounts" shape=cylinder fillcolor="#fde8d0"];
    S3 [label="AWS S3\nitem-bank assets + work-upload photos" shape=cylinder fillcolor="#fde8d0"];
  }

  // ---- Layer 4: Authoring pipeline (offline) ----
  subgraph cluster_pipeline {
    label="Authoring Pipeline (offline)"; style="rounded,filled"; fillcolor="#faf5ff"; color="#94a3b8"; fontsize=12;
    SEED [label="Open banks (MyOpenMath)" fillcolor="#f3e8ff"];
    AIGEN [label="AI generate variants" fillcolor="#f3e8ff"];
    VALID [label="Team validation + difficulty tagging" fillcolor="#f3e8ff"];
  }

  MOBILE [label="Mobile work-upload (post-MVP): QR one-shot" fillcolor="#f1f5f9" style="rounded,filled,dashed"];

  // within-cluster vertical stacking (keeps each layer narrow)
  DUI -> LUI -> GUI [style=invis];
  GWIDGET -> MINPUT -> SCLIENT [style=invis];
  DENG -> LENG -> GENG -> MSVC -> SCORER [style=invis];
  STATE -> ASSESS -> GRAPHDB -> BANK -> AUTH -> S3 [style=invis];
  SEED -> AIGEN -> VALID [style=invis];

  // UI -> engine
  DUI -> DENG;
  LUI -> LENG;
  GUI -> GENG;
  DUI -> GWIDGET [style=dashed, label="uses"];
  LUI -> MINPUT [style=dashed];
  LUI -> GWIDGET [style=dashed];

  // engines -> data
  DENG -> STATE [label="write placement_estimate"];
  LENG -> MSVC [label="submitAssessmentEvidence"];
  GENG -> STATE [label="reads mastery, sets checkpoint"];
  MSVC -> SCORER [label="recompute correctness"];
  SCORER -> ASSESS [label="authoritative_correct"];
  MSVC -> STATE [label="writes mastery, monotonic"];
  BANK -> S3 [style=dashed, label="stored in"];
  DENG -> ASSESS [label="pretest = placement"];
  DENG -> GRAPHDB;
  LENG -> BANK;
  GENG -> GRAPHDB;
  SCLIENT -> STATE;

  // authoring feeds the bank
  VALID -> BANK [label="validated items"];
  MOBILE -> STATE [style=dashed, label="upload"];
}
